# Required in production: generate with `openssl rand -hex 32`
MIZAN_SESSION_SECRET=replace-with-strong-64-char-random-hex-secret

# Set to "false" in production to hide & disable one-click demo buttons
ENABLE_DEMO_LOGIN=false

# Set to your production web domain (or "*" if allowing mobile Expo clients)
ALLOWED_ORIGIN=https://app.yourdomain.com

# Persistent directory where mizan.db is stored (mount a volume here)
DATA_DIR=./data

# Optional: force Secure cookie flag (auto-detected via X-Forwarded-Proto behind HTTPS proxies)
# COOKIE_SECURE=true

# Optional Payment Providers (omit to use built-in Sandbox checkout simulator)
# CHAPA_SECRET_KEY=CHASECK_TEST-xxxx
# STRIPE_SECRET_KEY=sk_test_xxxx
# APP_URL=https://app.yourdomain.com

# Optional Telegram & SMS Customer Alerts (omit to use built-in Sandbox simulator)
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF
# SMS_WEBHOOK_URL=https://api.afromessage.com/api/send
# SMS_API_KEY=your-sms-provider-key

PORT=3000
