# Required when NODE_ENV=production (Docker sets that for you).
# Generate a value with: openssl rand -hex 32
# The server refuses to start if this is missing, shorter than 32 characters, or a sample phrase.
MIZAN_SESSION_SECRET=

# Sample companies and the published demo password are created only when this is exactly "true".
# Leave it false for a real business.
ENABLE_DEMO_LOGIN=false

# Optional first administrator, used only when the database has no users yet.
# Set both the email and the password, or leave both empty and create the account on the sign-up page.
# The password must be at least 12 characters and must not be a sample password.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=
# Optional company created for that administrator, with a chart of accounts.
INITIAL_COMPANY_NAME=
INITIAL_COMPANY_CURRENCY=ETB

# Public address of this site, such as https://mizanbooks.tech.
# Cookie-based changes are rejected unless the browser's Origin matches this value.
# Leave it as * only when the site and the API share one host name.
ALLOWED_ORIGIN=https://app.yourdomain.com

# Operator page at /admin. No default password. Leave empty to turn /admin off.
# At least 12 characters, and not a sample password.
OPERATOR_PASSWORD=

# Public sign-up on /app. On by default. Set false, 0, off, or no to turn it off.
SIGNUP_ENABLED=true

# Optional address shown on the public Contact page. Leave empty to show no email.
# The contact form stores messages in the database either way. It does not send mail.
CONTACT_EMAIL=

# Folder that holds mizan.db. Mount a disk here.
DATA_DIR=./data

# Optional: force the login cookie's Secure flag after HTTPS is in front of the app.
# COOKIE_SECURE=true

# Optional Payment Providers. Online invoice payments only appear in the app while
# ENABLE_SANDBOX_PAYMENTS=true (a developer test switch: keep it OFF in production).
# Live Chapa/Stripe payments cannot confirm themselves yet; that needs a verified webhook first.
# ENABLE_SANDBOX_PAYMENTS=false
# CHAPA_SECRET_KEY=CHASECK_TEST-xxxx
# STRIPE_SECRET_KEY=sk_test_xxxx
# APP_URL=https://app.yourdomain.com

# Optional Telegram & SMS Customer Alerts (omit to use built-in Sandbox simulator)
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF
# SMS_WEBHOOK_URL=https://api.afromessage.com/api/send
# SMS_API_KEY=your-sms-provider-key

PORT=3000

# Automatic SQLite backups. Keep these on a different disk from DATA_DIR when you can.
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
# How often the Docker backup service takes a new copy, in seconds. 86400 is once a day.
BACKUP_INTERVAL_SECONDS=86400
